# calc_entry_after_result_operator_ans.numos — INTEGRATION-01 entry after result.
# Keys: 2 ENTER + 3 ENTER -> Ans+3 = 5 (Ans serializes as numos_Ans).
# Rule: a digit typed right after ENTER starts a new entry; an operator
# continues from Ans; caret navigation (LEFT/RIGHT/")"), DEL and history
# recall end the fresh-result state, so later keys edit the shown input.
# Assert-only (no screenshot, no golden).
# Run: program --headless --deterministic --quiet --frames 1200 --script <this>
wait 200
open_app Calculation
wait 60
set_angle_mode rad
key ac
key ac
key 2
key enter
wait 120
key +
key 3
wait 3
assert_calc_input serialized numos_Ans+3
key enter
wait 120
assert_calc_exact 5
log "calc_entry_after_result_operator_ans: PASS"
