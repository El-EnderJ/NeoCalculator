# CORRECTNESS-E2E-01 W5-F01: x^(2/3) = 4 -> {8} (Giac principal power convention; -8 is open as a convention question)
# Regression: the solution set must match the mathematical truth (count + each value).
wait 200
set_equations_complex_policy real
set_angle_mode rad
open_app Equations
wait 60
key ac
key up
key up
key up
key up
key del
key del
key del
key enter
key enter
key x
key ^
key /
key 2
key right
key 3
key right
key right
key =
key 4
key enter
key down
key down
key down
key down
key enter
wait 1
dump_equations pow23_real
assert_equations_engine giac
assert_equations_status ok
assert_equations_solution_count 1
assert_equations_solution_exact x 0 8
assert_equations_result_kind structured
