# CORRECTNESS-E2E-01 W5-F02/F03: xy=6, x+y=5 -> {(2,3),(3,2)}
# Regression: the solution set must match the mathematical truth (count + each value).
wait 200
set_equations_complex_policy real
set_angle_mode rad
open_app Equations
wait 60
key ac
key up
key up
key up
key up
key del
key del
key del
key enter
key enter
key x
key y
key =
key 6
key enter
key down
key enter
key enter
key x
key +
key y
key =
key 5
key enter
key down
key down
key down
key down
key enter
wait 1
dump_equations sum_product
assert_equations_engine giac
assert_equations_status ok
assert_equations_solution_count 2
assert_equations_solution_exact x 0 2
assert_equations_solution_exact y 0 3
assert_equations_solution_exact x 1 3
assert_equations_solution_exact y 1 2
assert_equations_result_kind structured
