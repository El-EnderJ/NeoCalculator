# calc_semantic_new_entry_after_result.numos — typing after a result starts a
# NEW expression; the second calculation must not depend on the first.
#
# READINESS-01 regression: before the fix, clearResult() only hid the
# result and the next key was inserted into the previous expression, so
# "2/6 ENTER sqrt 9 ENTER" evaluated (2/6)*sqrt(9) instead of sqrt(9).
#
#   2 / 6 ENTER       -> 1/3
#   sqrt 9 ENTER      -> 3        (no AC in between)
#   4 * 5 ENTER       -> 20       (digit after a result also starts fresh)
#
# Run: program --headless --deterministic --script <this> --frames 1400 --quiet
# Exit codes: 0 ok · 2 parse · 3 screenshot · 4 assertion failure.

log "calc_semantic_new_entry_after_result: waiting for launcher"
wait 200
open_app Calculation
wait 60

key 2
key FRAC
key 6
key RIGHT
key ENTER
wait 120
assert_no_error
assert_result 1/3

# No AC: a function key after a result must open a fresh expression.
key sqrt
key 9
key RIGHT
key ENTER
wait 120
assert_no_error
assert_result 3

# No AC: a digit after a result must open a fresh expression.
key 4
key *
key 5
key ENTER
wait 120
assert_app Calculation
assert_no_error
assert_result 20
log "calc_semantic_new_entry_after_result: PASS (sqrt(9) == 3, 4*5 == 20)"
