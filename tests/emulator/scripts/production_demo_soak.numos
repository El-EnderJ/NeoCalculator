# Bounded automatic host/emulator soak. Physical soak is separately opt-in via
# the hidden "DEMO SOAK START CONFIRM" operator command.
wait 200
assert_app Menu

# Ten mixed lifecycle cycles in one process.
open_app Calculation
key 1
key +
key 1
key enter
wait 20
key ac
key home
wait 30
open_app Grapher
key down
key enter
key y
key =
key x
key enter
wait 20
key home
wait 40
assert_giac_live_handles 0
open_app Settings
wait 10
key back
wait 30

open_app Calculation
key shift
key alpha
keydown 8
key home
keyup 8
wait 30
open_app Grapher
key down
key enter
key x
key enter
wait 20
key home
wait 40
assert_giac_live_handles 0

