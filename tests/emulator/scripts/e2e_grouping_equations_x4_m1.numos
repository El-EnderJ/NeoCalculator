# CORRECTNESS-E2E-01 GROUPING (W5-F10): complex roots (1+i)*sqrt(2)/2 of x^4=-1 were shown as
# (1 + i*sqrt(2))/2. assert_equations_solution_exact pins Giac's roots; the displayed rows
# ([PERIODIC_RESULT]) are value-checked by out/correctness-e2e-01/phase4/GROUPING/check_display.sh;
# structure is asserted by the host regression. No golden, no CI wiring.
wait 200
set_equations_complex_policy complex
open_app Equations
wait 60
set_angle_mode rad
key ENTER
key ENTER
key x
key ^
key 4
key RIGHT
key =
key neg
key 1
key ENTER
key DOWN
key DOWN
key DOWN
key DOWN
key ENTER
wait 180
assert_equations_status ok
assert_equations_solution_count 4
assert_equations_solution_exact x 0 (-1+i)*sqrt(2)/2
assert_equations_solution_exact x 1 (-1-i)*sqrt(2)/2
assert_equations_solution_exact x 2 (1+i)*sqrt(2)/2
assert_equations_solution_exact x 3 (1-i)*sqrt(2)/2
dump_equations G|x4_m1
assert_equations periodic dump
