  "name": "NumOS production ESP32-S3-WROOM-1U-N16R8 (native USB CDC/JTAG, 16 MB QIO flash, 8 MB OPI PSRAM)",
  "numos_hardware_contract": {
    "module": "ESP32-S3-WROOM-1U-N16R8",
    "external_flash_bytes": 16777216,
