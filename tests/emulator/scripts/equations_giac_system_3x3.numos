# GIAC-D01: enabled 3x3 mode; ALPHA+y authors z in the AST.
# DEVICE-INPUT-PATH-01: lowercase z is only reachable through the legacy
# logical chord ALPHA + y (lkey). On the production keypad ALPHA + 6 gives
# uppercase Z, which the solver does not take as the third unknown (open).
wait 200
open_app Equations
wait 60
key ENTER
key ENTER
key x
key +
key y
key +
lkey ALPHA
lkey y
key =
key 6
key ENTER
key DOWN
key ENTER
key ENTER
key 2
key *
key x
key -
key y
key +
lkey ALPHA
lkey y
key =
key 3
key ENTER
key DOWN
key ENTER
key ENTER
key x
key +
key 2
key *
key y
key -
lkey ALPHA
lkey y
key =
key 2
key ENTER
key DOWN
key ENTER
wait 220
assert_equations_engine giac
assert_equations_status ok
assert_equations_solution_count 1
assert_equations_solution_exact x 0 1
assert_equations_solution_exact y 0 2
assert_equations_solution_exact z 0 3
assert_equations_result_kind structured
assert_equations_tutor_status complete
