# CORRECTNESS-E2E-01 W5-F02/F03: x^2+y^2=25, x+y=7 -> {(3,4),(4,3)}
# Regression: the solution set must match the mathematical truth (count + each value).
wait 200
set_equations_complex_policy real
set_angle_mode rad
open_app Equations
wait 60
key ac
key up
key up
key up
key up
key del
key del
key del
key enter
key enter
key x
key ^
key 2
key right
key +
key y
key ^
key 2
key right
key =
key 2
key 5
key enter
key down
key enter
key enter
key x
key +
key y
key =
key 7
key enter
key down
key down
key down
key down
key enter
wait 1
dump_equations circle_line
assert_equations_engine giac
assert_equations_status ok
assert_equations_solution_count 2
