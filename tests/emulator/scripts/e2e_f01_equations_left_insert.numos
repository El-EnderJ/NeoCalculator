# CORRECTNESS-E2E-01 F01: Equations x=3 LEFT 5 shows x=53
# Two adjacent number nodes render as one numeral; the value computed must be
# the value displayed. Assert-only (no screenshot, no golden, no CI wiring).
wait 200
open_app Equations
wait 60
set_angle_mode rad
set_equations_complex_policy real
key ac
key up
key up
key up
key up
key del
key del
key del
key enter
key enter
key x
key =
key 3
key left
key 5
wait 3
key enter
key down
key down
key down
key down
key enter
wait 160
assert_equations_status ok
assert_equations_solution_count 1
assert_equations_solution_exact x 0 53
