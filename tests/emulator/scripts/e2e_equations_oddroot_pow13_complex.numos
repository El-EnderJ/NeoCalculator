# CORRECTNESS-E2E-01 W5-F01: x^(1/3) = 5, complex policy -> 125
# Regression: the solution set must match the mathematical truth (count + each value).
wait 200
set_equations_complex_policy complex
set_angle_mode rad
open_app Equations
wait 60
key ac
key up
key up
key up
key up
key del
key del
key del
key enter
key enter
key x
key ^
key /
key 1
key right
key 3
key right
key right
key =
key 5
key enter
key down
key down
key down
key down
key enter
wait 1
dump_equations pow13_complex
assert_equations_engine giac
assert_equations_status ok
assert_equations_solution_count 1
assert_equations_solution_exact x 0 125
assert_equations_result_kind structured
