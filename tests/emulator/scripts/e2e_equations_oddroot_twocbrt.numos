# CORRECTNESS-E2E-01 W5-F01: 2*cbrt(x) = 6 -> 27
# Regression: the solution set must match the mathematical truth (count + each value).
wait 200
set_equations_complex_policy real
set_angle_mode rad
open_app Equations
wait 60
key ac
key up
key up
key up
key up
key del
key del
key del
key enter
key enter
key 2
equations_physical 4 0
equations_physical 1 2
key 3
key right
key x
key right
key =
key 6
key enter
key down
key down
key down
key down
key enter
wait 1
dump_equations twocbrt
assert_equations_engine giac
assert_equations_status ok
assert_equations_solution_count 1
assert_equations_solution_exact x 0 27
assert_equations_result_kind structured
