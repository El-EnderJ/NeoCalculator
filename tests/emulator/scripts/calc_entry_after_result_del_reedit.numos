# calc_entry_after_result_del_reedit.numos — INTEGRATION-01 entry after result.
# Keys: 2+3 ENTER DEL 4 ENTER -> re-edit 2+4 = 6.
# Rule: a digit typed right after ENTER starts a new entry; an operator
# continues from Ans; caret navigation (LEFT/RIGHT/")"), DEL and history
# recall end the fresh-result state, so later keys edit the shown input.
# Assert-only (no screenshot, no golden).
# Run: program --headless --deterministic --quiet --frames 1200 --script <this>
wait 200
open_app Calculation
wait 60
set_angle_mode rad
key ac
key ac
key 2
key +
key 3
key enter
wait 120
key del
key 4
wait 3
assert_calc_input serialized 2+4
key enter
wait 120
assert_calc_exact 6
log "calc_entry_after_result_del_reedit: PASS"
