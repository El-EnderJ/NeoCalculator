    "external_psram_bytes": 8388608,
    "psram_bus": "OPI",
    "psram_frequency_hz": 80000000,
    "usb": "ESP32-S3 native USB Serial/JTAG on GPIO19/GPIO20",
    "onboard_uart_bridge": false
  },
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 327680,
    "maximum_size": 6553600,
    "require_upload_port": true,
    "speed": 460800
  },
