# CORRECTNESS-E2E-01 W5-F02 control: linear 2x2 unique solution (2,1)
# Regression: the solution set must match the mathematical truth (count + each value).
wait 200
set_equations_complex_policy real
set_angle_mode rad
open_app Equations
wait 60
key ac
key up
key up
key up
key up
key del
key del
key del
key enter
key enter
key x
key +
key y
key =
key 3
key enter
key down
key enter
key enter
key x
key -
key y
key =
key 1
key enter
key down
key down
key down
key down
key enter
wait 1
dump_equations linear_2x2
assert_equations_engine giac
assert_equations_status ok
assert_equations_solution_count 1
assert_equations_solution_exact x 0 2
assert_equations_solution_exact y 0 1
assert_equations_result_kind structured
